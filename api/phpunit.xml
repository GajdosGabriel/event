<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Testy musia zapisovať lokálne. Bez tohto by zdedili FILESYSTEM_DISK
             z .env a pri prepnutí na s3 by písali do reálneho bucketu. -->
        <env name="FILESYSTEM_DISK" value="public"/>
        <!-- <env name="DB_CONNECTION" value="sqlite"/> -->
        <!-- <env name="DB_DATABASE" value=":memory:"/> -->
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="IMPORTS_DETECT_CANAL_WITH_AI" value="false"/>
        <!-- Odstup medzi dotazmi na Nominatim je zdvorilost voci verejnej sluzbe;
             v testoch chodi geokoder cez Http::fake, takze by len spomaloval. -->
        <env name="NOMINATIM_MIN_INTERVAL" value="0"/>
        <!-- Napojenie na Account je v testoch vypnuté. Bez tohto by sa do behu
             prepísal ACCOUNT_TOKEN z lokálneho .env a testy, ktoré Account
             nefakujú (zakladanie organizácie), by strieľali na account.local
             a padali na 503. CI má .env.example s prázdnym tokenom, takže by
             červené bolo len u vývojára — čo je ten horší prípad.
             OrganizationAccountSyncTest si napojenie zapína sám cez config(). -->
        <env name="ACCOUNT_URL" value="https://account.test"/>
        <env name="ACCOUNT_TOKEN" value=""/>
        <env name="ACCOUNT_WEBHOOK_SECRET" value=""/>
        <env name="IMPORTS_DESCRIBE_WITH_AI" value="false"/>
         <env name="DB_CONNECTION" value="mysql"/>
    <env name="DB_DATABASE" value="event-test"/>
    <env name="DB_USERNAME" value="root"/>
    <env name="DB_PASSWORD" value=""/>
     <env name="DB_MIGRATE_BEFORE_TEST" value="true"/>
     <!-- <env name="DB_SEED" value="false"/> -->
    </php>
</phpunit>
