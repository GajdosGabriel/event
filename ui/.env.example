# Google OAuth Client ID (typ "Web application"), rovnaké ako GOOGLE_CLIENT_ID v api/.env.
# Authorized JavaScript origins musia obsahovať http://localhost:5173, http://event.local
# a produkčnú doménu. Redirect URI sa nepoužíva (ID-token flow).
# Premenná sa zapeká do buildu (`npm run build`), takže na produkcii musí byť
# nastavená pred buildom frontendu.
VITE_GOOGLE_CLIENT_ID=

# Cloudflare Turnstile (náhrada captchy) pred registráciou, opätovným overovacím
# e-mailom a zabudnutým heslom. Site key z Cloudflare → Turnstile; secret key
# patrí do api/.env ako TURNSTILE_SECRET_KEY. Zapínať spolu — backend s kľúčom
# a frontend bez widgetu odmietne každú registráciu. Zapeká sa do buildu.
# Na localhoste sa dá použiť testovací kľúč 1x00000000000000000000AA
# (s backendovým 1x0000000000000000000000000000000AA).
VITE_TURNSTILE_SITE_KEY=
