# SPA + dosah (Vue Router, bot-render, sitemap) — Apache.
#
# POZOR: toto je ŠABLÓNA, nie produkčný súbor. Nikdy ju nekopíruj celú na
# produkciu. Docroot subdomény je koreň repozitára, nie tento priečinok, takže
# aktívny .htaccess tam navyše mapuje požiadavky do ui/dist/ a /api/ do
# api/public/ — pravidlá, ktoré tu chýbajú. Prepísaním aktívneho súboru týmto
# obsahom zmizne mapovanie na súbory a subdoména padne na 403 v koreni a 404
# všade inde; aktívny súbor je mimo gitu, takže sa nedá obnoviť git-om.
#
# Do produkčného .htaccess sa dopisujú len bloky nižšie. Postup: deploy/htaccess.md
#
# Poradie pravidiel je podstatné: sitemap a crawler musia byť pred SPA
# fallbackom, inak by ich prepísal na index.html.

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # --- 0. starý prefix podujatí ---------------------------------------
    # Podujatia sa presťahovali z /podujatia/{slug}-{id} na /akcie/{id}/{slug}.
    # Staré adresy sú zaindexované a rozposlané v e-mailoch, takže musia ostať
    # funkčné. Rieši to aj Vue Router, ale ten beží až po načítaní JS a
    # vyhľadávač z neho prenos hodnotenia nevyčíta — na to treba 301 tu.
    #
    # Poradie: najprv detail (končí na -{id}), až potom landing výpisy, inak by
    # všeobecné pravidlo pohltilo aj `mesto` a `tema`. Slug sa zahadzuje, novú
    # kanonickú podobu aj tak doplní presmerovanie na detaile.
    RewriteRule ^podujatia/(?:.*-)?([0-9]+)/?$ /akcie/$1 [R=301,L]
    RewriteRule ^podujatia(/.*)?$ /akcie$1 [R=301,L]

    # --- 1. sitemap.xml -------------------------------------------------
    # Mapu generuje Laravel (cache 1 h). Na SPA hoste musí byť dostupná na
    # koreňovej ceste — inak ju Search Console odmietne ako mimo rozsahu.
    RewriteRule ^sitemap\.xml$ /api/sitemap.xml [L]

    # --- 2. crawlery a náhľady odkazov ----------------------------------
    # Facebook, Messenger, WhatsApp, LinkedIn ani vyhľadávače nespúšťajú JS.
    # Dostanú serverom vykreslenú verziu tej istej stránky; ľudia idú do SPA.
    #
    # Podmienky zdola nahor: nikdy neprepisuj backend prefixy (inak vznikne
    # slučka pri internom podrequeste) a nikdy statické súbory (og:image musí
    # ostať obrázkom, nie HTML stránkou).
    RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|facebookcatalog|Facebot|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Slackbot|Discordbot|SkypeUriPreview|Applebot|Googlebot|Google-InspectionTool|Storebot-Google|AdsBot-Google|bingbot|YandexBot|DuckDuckBot|SeznamBot|redditbot|Pinterest|vkShare|Embedly|Quora\ Link\ Preview|W3C_Validator) [NC]
    RewriteCond %{REQUEST_URI} !^/(api|sanctum|storage|images)/
    RewriteCond %{REQUEST_URI} !\.(js|mjs|css|png|jpe?g|gif|svg|webp|avif|ico|woff2?|ttf|map|txt|xml|pdf|webmanifest)$
    RewriteRule ^(.*)$ /api/prerender?path=/$1 [QSA,L]

    # --- 2b. widget pre cudzie weby -------------------------------------
    # Značka pre hlavičky nižšie. `-` neprepisuje a bez `L` sa pokračuje
    # ďalšími pravidlami — ide len o nastavenie premennej.
    RewriteRule ^embed(/|$) - [E=EVENT_EMBED:1]

    # --- 3. statické súbory ---------------------------------------------
    # Ak požadovaný súbor alebo priečinok reálne existuje (assets, favicon,
    # robots.txt, index.html), servuj ho priamo bez prepisu.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # --- 4. SPA fallback -------------------------------------------------
    # Backend prefixy nechaj tak, ako sú (nikdy ich neprepisuj na index.html).
    RewriteCond %{REQUEST_URI} !^/(api|sanctum|storage|images)/
    # Všetko ostatné smeruj na SPA vstupný bod.
    RewriteRule ^ index.html [L]
</IfModule>

# Vkladanie do cudzieho iframe.
#
# Predvolene zakázané: bez toho sa dá dashboard aj prihlásenie natiahnuť do
# priehľadného rámu na cudzej stránke a nechať človeka klikať naslepo
# (clickjacking). Portál sám rámovanie nikde nepotrebuje.
#
# Výnimka je widget `/embed/...` — ten je na cudzích weboch celý zmysel veci.
# Premennú nastavuje pravidlo 2b vyššie; po internom prepise na index.html ju
# Apache prefixuje `REDIRECT_`, preto sa testujú obe mená.
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Content-Security-Policy "frame-ancestors 'self'"

    Header always unset X-Frame-Options env=EVENT_EMBED
    Header always unset X-Frame-Options env=REDIRECT_EVENT_EMBED
    Header always set Content-Security-Policy "frame-ancestors *" env=EVENT_EMBED
    Header always set Content-Security-Policy "frame-ancestors *" env=REDIRECT_EVENT_EMBED
</IfModule>

# Ak by mod_rewrite nebol dostupný, aspoň neexistujúce cesty vráť ako SPA.
<IfModule !mod_rewrite.c>
    ErrorDocument 404 /index.html
</IfModule>
